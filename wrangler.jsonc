{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "asdf",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "536baaff-0d26-46b0-ae0d-50e734cc2980","database_name": "pp" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "0f7e955ae5964208a72899b57aeac00b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
